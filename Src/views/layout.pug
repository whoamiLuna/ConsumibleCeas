include partials/notifications.pug


doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        meta(name="autor", content="Luis Luna")
        meta(name="keywords",content="Inventario Consumibles Reportes Impresoras Toners Tintas Cartuchos ")
        meta(name="description", content= description)
        link(rel="shortcut icon", href="/IMG/CEAS.ico", type="image/x-icon")
        link(rel="stylesheet", href="/CSS/normalize.css")
        link(rel="stylesheet", href="/CSS/index.css")
        link(rel="stylesheet", href="/CSS/navDashborad.css")
        link(rel="stylesheet", href="/CSS/notifications.css")
        link(rel="stylesheet", href="/CSS/modalDelete.css")
        link(rel="stylesheet", href=style)
        link(href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css", rel="stylesheet")
        if dataListSearch
            link(rel="stylesheet", href="/CSS/dataList.css")
        if entradas=== true || equipos=== true
            link(rel="stylesheet", href="/CSS/formFolio.css")
        if totals && totals.length > 0
            link(rel="stylesheet", href="/CSS/totalsBtn.css")
        if inputs && inputs.length > 0
            link(rel="stylesheet", href="/CSS/loginForm.css")
        if formShowInputs && formShowInputs.length && formShowAdd && Object.keys(formShowAdd).length
            link(rel="stylesheet", href="/CSS/formShowAdd.css")
        if dataHead && dataHead.length > 0
            link(rel="stylesheet", href="/CSS/tableContent.css")
        if page && totalPage
            link(rel="stylesheet", href="/CSS/navPagination.css")
        if containerData
            link(rel="stylesheet", href="/CSS/datacontainer.css")
        title= titles
    body
        aside.aside 
            figure.aside__logo
                li.aside__iconMenu(class="fas fa-bars")
                img.aside__logo-img(src="/IMG/CEAS.png", alt="Logo")
            ul.aside__navItems
                each item in navItems   
                     li.aside__navItems-li           
                        a.navItems__li-a(href=item.hrefNav, title=item.spanTitle)
                            i.li__a-icon(class=item.class_icon)
                            span.li__a-span= item.spanTitle
        +notifications()
        main.main
            block content  
           
        script(src="https://kit.fontawesome.com/8695bfc184.js", crossorigin="anonymous")
        script(src=Script, type="module")
        script(src="/JS/index.js", type="module")
        script(src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js")